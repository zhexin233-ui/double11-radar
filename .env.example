# 线报需求匹配与推送 —— 部署环境配置示例
#
# 复制为 .env 后按需修改。web 与 worker 必须使用完全相同的 DATA_DIR、
# APP_ENCRYPTION_KEY 与 ADMIN_PASSWORD。
#
# 生成 32 字节 base64 加密密钥：
#   openssl rand -base64 32
#
# 生成管理员密码的 scrypt 哈希（可选，用于部署核对）：
#   pnpm admin:hash

# 持久化目录，SQLite 位于 $DATA_DIR/xianbao.db
DATA_DIR=/data

# 必需：base64 编码的 32 字节密钥，用于 AES-256-GCM 加密凭据。
# 必须保持不变，否则已保存的凭据无法解密。备份数据库时必须一并备份该密钥。
APP_ENCRYPTION_KEY=

# 必需：管理员登录密码（明文仅用于部署配置，数据库只保存 scrypt 哈希）。
ADMIN_PASSWORD=

# 可选：局域网 HTTP 首次部署建议 false；经反向代理提供 HTTPS 时设为 true。
COOKIE_SECURE=false

# 可选：web 服务端口，默认 3000。
PORT=3000

# 可选：线报酷 API 基地址，默认官方地址。
XIANBAO_API_BASE=https://new.xianbao.fun
